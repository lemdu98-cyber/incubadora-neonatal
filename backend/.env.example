# Configuración local del servidor
PORT=3001
NODE_ENV=development

# Configuración de servidor. URL y publishable key no son secretos, pero esta
# copia pertenece al backend. La secret key es un secreto estrictamente privado.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Conexión privada PostgreSQL usada exclusivamente por el backend
DATABASE_URL=

# JWT: no requieren variables duplicadas.
# Issuer:  {SUPABASE_URL}/auth/v1
# JWKS:    {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Audience fija para usuarios: authenticated
