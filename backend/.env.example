# Configuración local del servidor
PORT=3001
NODE_ENV=development

# Configuración de servidor. URL y publishable key no son secretos, pero esta
# copia pertenece al backend. La service role es un secreto estrictamente privado.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión privada PostgreSQL usada exclusivamente por el backend
DATABASE_URL=

# Metadatos públicos del emisor usados por el backend para validar JWT
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
