generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  engineType          = "client"
}

datasource db {
  provider = "postgresql"
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("profile_status")
}

enum PatientSex {
  MALE
  FEMALE
  UNSPECIFIED

  @@map("patient_sex")
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN

  @@map("blood_type")
}

enum PatientStatus {
  ACTIVE
  INACTIVE

  @@map("patient_status")
}

enum GuardianRelationship {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  GRANDMOTHER
  GRANDFATHER
  OTHER

  @@map("guardian_relationship")
}

enum IncubatorStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE

  @@map("incubator_status")
}

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED
  CANCELLED

  @@map("admission_status")
}

enum DeviceType {
  ESP32
  ESP8266
  OTHER

  @@map("device_type")
}

enum DeviceStatus {
  ACTIVE
  MAINTENANCE
  DISABLED

  @@map("device_status")
}

enum SensorType {
  DHT11
  DHT22
  MAX30100
  MAX30205
  OTHER

  @@map("sensor_type")
}

enum SensorStatus {
  ACTIVE
  MAINTENANCE
  DISABLED

  @@map("sensor_status")
}

enum MeasurementValueType {
  FLOAT
  INTEGER
  BOOLEAN

  @@map("measurement_value_type")
}

enum MeasurementCategory {
  ENVIRONMENTAL
  PHYSIOLOGICAL
  TECHNICAL

  @@map("measurement_category")
}

enum TelemetryQuality {
  GOOD
  SUSPECT
  INVALID

  @@map("telemetry_quality")
}

model Profile {
  id        String        @id @db.Uuid
  firstName String        @map("first_name") @db.VarChar(100)
  lastName  String        @map("last_name") @db.VarChar(100)
  status    ProfileStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles UserRole[]

  @@map("profiles")
}

model Role {
  id          Int        @id @default(autoincrement()) @db.SmallInt
  code        String     @unique @db.VarChar(40)
  name        String     @db.VarChar(100)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  profileId  String   @map("profile_id") @db.Uuid
  roleId     Int      @map("role_id") @db.SmallInt
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([profileId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Patient {
  id                  String            @id @default(uuid()) @db.Uuid
  medicalRecordNumber String            @unique @map("medical_record_number") @db.VarChar(50)
  firstName           String            @map("first_name") @db.VarChar(100)
  lastName            String            @map("last_name") @db.VarChar(100)
  birthDate           DateTime          @map("birth_date") @db.Date
  birthTime           DateTime?         @map("birth_time") @db.Time(0)
  sex                 PatientSex
  birthWeightGrams    Int               @map("birth_weight_grams")
  gestationalAgeWeeks Int               @map("gestational_age_weeks") @db.SmallInt
  gestationalAgeDays  Int               @map("gestational_age_days") @db.SmallInt
  bloodType           BloodType         @map("blood_type")
  status              PatientStatus     @default(ACTIVE)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guardians           PatientGuardian[]
  admissions          Admission[]

  @@index([createdAt(sort: Desc)])
  @@map("patients")
}

model Guardian {
  id             String            @id @default(uuid()) @db.Uuid
  firstName      String            @map("first_name") @db.VarChar(100)
  lastName       String            @map("last_name") @db.VarChar(100)
  documentNumber String?           @map("document_number") @db.VarChar(80)
  phone          String?           @db.VarChar(40)
  email          String?           @db.VarChar(254)
  address        String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  patients       PatientGuardian[]

  @@index([documentNumber])
  @@index([createdAt(sort: Desc)])
  @@map("guardians")
}

model PatientGuardian {
  patientId        String               @map("patient_id") @db.Uuid
  guardianId       String               @map("guardian_id") @db.Uuid
  relationship     GuardianRelationship
  isPrimaryContact Boolean              @default(false) @map("is_primary_contact")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  patient          Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  guardian         Guardian             @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([patientId, guardianId])
  @@index([guardianId])
  @@map("patient_guardians")
}

model Incubator {
  id           String          @id @default(uuid()) @db.Uuid
  code         String          @unique @db.VarChar(50)
  name         String          @db.VarChar(120)
  location     String          @db.VarChar(150)
  serialNumber String?         @unique @map("serial_number") @db.VarChar(100)
  manufacturer String?         @db.VarChar(100)
  model        String?         @db.VarChar(100)
  status       IncubatorStatus @default(AVAILABLE)
  notes        String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  admissions   Admission[]
  devices      Device[]
  telemetry    Telemetry[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("incubators")
}

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  hardwareUid     String       @unique @map("hardware_uid") @db.VarChar(100)
  code            String       @unique @db.VarChar(50)
  deviceType      DeviceType   @map("device_type")
  incubatorId     String       @map("incubator_id") @db.Uuid
  status          DeviceStatus @default(ACTIVE)
  firmwareVersion String?      @map("firmware_version") @db.VarChar(50)
  lastSeenAt      DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  notes           String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  incubator       Incubator    @relation(fields: [incubatorId], references: [id], onDelete: Restrict)
  sensors         Sensor[]
  telemetry       Telemetry[]

  @@index([incubatorId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("devices")
}

model Sensor {
  id                  String             @id @default(uuid()) @db.Uuid
  code                String             @unique @db.VarChar(50)
  sensorType          SensorType         @map("sensor_type")
  deviceId            String             @map("device_id") @db.Uuid
  status              SensorStatus       @default(ACTIVE)
  channel             String?            @db.VarChar(50)
  calibrationMetadata Json?              @map("calibration_metadata") @db.JsonB
  notes               String?            @db.Text
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  device              Device             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  capabilities        SensorCapability[]
  telemetry           Telemetry[]

  @@index([deviceId])
  @@index([sensorType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("sensors")
}

model MeasurementDefinition {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique @db.VarChar(60)
  name          String               @db.VarChar(120)
  unitSymbol    String               @map("unit_symbol") @db.VarChar(30)
  valueType     MeasurementValueType @map("value_type")
  category      MeasurementCategory
  description   String?              @db.VarChar(255)
  decimalPlaces Int                  @map("decimal_places") @db.SmallInt
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  capabilities  SensorCapability[]
  telemetry     Telemetry[]

  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("measurement_definitions")
}

model SensorCapability {
  sensorId                String                @map("sensor_id") @db.Uuid
  measurementDefinitionId String                @map("measurement_definition_id") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sensor                  Sensor                @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  measurementDefinition   MeasurementDefinition @relation(fields: [measurementDefinitionId], references: [id], onDelete: Restrict)

  @@id([sensorId, measurementDefinitionId])
  @@index([measurementDefinitionId])
  @@map("sensor_capabilities")
}

model Admission {
  id           String          @id @default(uuid()) @db.Uuid
  patientId    String          @map("patient_id") @db.Uuid
  incubatorId  String          @map("incubator_id") @db.Uuid
  admittedAt   DateTime        @map("admitted_at") @db.Timestamptz(6)
  dischargedAt DateTime?       @map("discharged_at") @db.Timestamptz(6)
  status       AdmissionStatus @default(ACTIVE)
  notes        String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  incubator    Incubator       @relation(fields: [incubatorId], references: [id], onDelete: Restrict)
  telemetry    Telemetry[]

  @@index([patientId, admittedAt(sort: Desc)])
  @@index([incubatorId, admittedAt(sort: Desc)])
  @@index([status])
  @@index([admittedAt(sort: Desc)])
  @@map("admissions")
}

model Telemetry {
  id                      BigInt                @id @default(autoincrement())
  deviceId                String                @map("device_id") @db.Uuid
  sensorId                String                @map("sensor_id") @db.Uuid
  measurementDefinitionId String                @map("measurement_definition_id") @db.Uuid
  incubatorId             String                @map("incubator_id") @db.Uuid
  admissionId             String?               @map("admission_id") @db.Uuid
  value                   Float                 @db.DoublePrecision
  measuredAt              DateTime              @map("measured_at") @db.Timestamptz(6)
  receivedAt              DateTime              @default(now()) @map("received_at") @db.Timestamptz(6)
  sequence                BigInt
  bootId                  String                @map("boot_id") @db.Uuid
  quality                 TelemetryQuality      @default(GOOD)
  device                  Device                @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  sensor                  Sensor                @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  measurementDefinition   MeasurementDefinition @relation(fields: [measurementDefinitionId], references: [id], onDelete: Restrict)
  incubator               Incubator             @relation(fields: [incubatorId], references: [id], onDelete: Restrict)
  admission               Admission?            @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  @@unique([deviceId, bootId, sequence, sensorId, measurementDefinitionId])
  @@index([sensorId, measuredAt(sort: Desc)])
  @@index([deviceId, measuredAt(sort: Desc)])
  @@index([incubatorId, measuredAt(sort: Desc)])
  @@index([admissionId, measuredAt(sort: Desc)])
  @@index([measurementDefinitionId, measuredAt(sort: Desc)])
  @@index([sensorId, measurementDefinitionId, measuredAt(sort: Desc)])
  @@map("telemetry")
}
